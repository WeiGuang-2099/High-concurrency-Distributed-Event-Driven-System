<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared logging config for every service (auction-common is on each service's
  classpath, and logback auto-loads logback-spring.xml from there).

  - CONSOLE: human-readable, always on. The [app,traceId,spanId] segment is the
    Micrometer/Brave trace context pulled from the SLF4J MDC.
  - LOGSTASH: JSON over TCP to Logstash (json_lines codec on :5000), which indexes
    into Elasticsearch (auction-logs index) for Kibana. Only active under the "elk"
    Spring profile, so a missing Logstash never spams reconnect errors in plain runs.
    Enable it by activating the elk Spring profile (see README); start ELK first.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="unknown"/>
    <property name="LOGSTASH_HOST" value="${LOGSTASH_HOST:-localhost}"/>
    <property name="LOGSTASH_PORT" value="${LOGSTASH_PORT:-5000}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [${appName},%X{traceId:-},%X{spanId:-}] %cyan(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
      Two complete, mutually exclusive profile blocks, each a direct child of <configuration>
      and each carrying its own <root>. Both parts of that matter:

      - A <springProfile> nested inside <root> is not supported by this logback version. With
        the appender declared at top level and only its appender-ref inside a nested profile,
        the appender was started in every run, so each service tried to reach Logstash every
        30 seconds and printed a stack trace when it could not, with or without the profile.
      - Moving only the appender into a profile and leaving the nested appender-ref behind is
        worse: <root> then depends on an appender that does not exist, logback skips <root>
        without an error, and the service logs nothing at all.
    -->
    <springProfile name="elk">
        <appender name="LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
            <destination>${LOGSTASH_HOST}:${LOGSTASH_PORT}</destination>
            <keepAliveDuration>5 minutes</keepAliveDuration>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <!-- traceId/spanId come through automatically (LogstashEncoder includes the MDC);
                     this just tags every line with its originating service. -->
                <customFields>{"service":"${appName}"}</customFields>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="LOGSTASH"/>
        </root>
    </springProfile>

    <springProfile name="!elk">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
